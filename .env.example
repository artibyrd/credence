# Credence Environment Configuration Example

# Environment Mode: development, staging, production
CREDENCE_ENV=development
CREDENCE_LOG_LEVEL=INFO

# Operational Cost Profile (offline, free, economy, balanced, ultra)
CREDENCE_PROFILE=economy
MAX_DAILY_BUDGET_USD=0.15
MAX_TOKENS_PER_HOUR=50000

# Storage & Database (Simple: SQLite + Local File / Advanced: PostgreSQL + R2 / S3)
DATABASE_URL=sqlite+aiosqlite:///data/credence.db
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-cool.neon.tech/credencedb?ssl=require

STORAGE_BACKEND=local
SNAPSHOT_DIR=data/snapshots
# STORAGE_BACKEND=s3
# S3_BUCKET_NAME=credence-snapshots
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your_r2_access_key
# S3_SECRET_ACCESS_KEY=your_r2_secret_key

# Distributed State & Cache (Simple: in-memory / Advanced: Redis / Upstash)
# REDIS_URL=rediss://default:pass@us1-upstash.io:6379

# Admin Authentication for mutating REST APIs (/api/cost/*)
# CREDENCE_ADMIN_API_KEY=your_secure_random_admin_token

# Google Antigravity & Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# FastMCP Server Settings
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Concurrency & Playwright Safeguards
MAX_CONCURRENT_SNAPSHOTS=2
PLAYWRIGHT_TIMEOUT_MS=30000
